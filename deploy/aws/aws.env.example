# Copy this file to .env.aws at the repository root. Never commit .env.aws.
APP_ENV=staging

POSTGRES_DB=admissions
POSTGRES_USER=admissions
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://admissions:REPLACE_WITH_THE_SAME_DATABASE_PASSWORD@db:5432/admissions

LLM_PROVIDER=ollama
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=qwen3:4b
LLM_TIMEOUT_SECONDS=180

KNOWLEDGE_PROVIDER=postgres
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ANSWER_MIN_SCORE=0.38
RUN_SEED_INGESTION=true

# Replace after AWS assigns the server IP. Multiple origins are comma-separated.
ALLOWED_ORIGINS=http://REPLACE_WITH_EC2_PUBLIC_IP
ADMIN_API_KEY=REPLACE_WITH_A_LONG_RANDOM_ADMIN_KEY

EMAIL_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USE_TLS=false
EMAIL_FROM=admissions@jhselectroniccity.com

OLLAMA_KEEP_ALIVE=15m
